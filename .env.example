# Copy to .env and change the passwords:  cp .env.example .env

# Superuser created by the postgres image. Used only for admin / init scripts.
POSTGRES_USER=climate
POSTGRES_PASSWORD=change_me
POSTGRES_DB=warehouse

# Host port for Postgres. 5432/5433 are often taken by other local projects.
POSTGRES_PORT=5434

# Role used by ingestion, dbt and Dagster: owns raw, modelled, reporting.
PIPELINE_USER=pipeline
PIPELINE_PASSWORD=change_me_pipeline

# Read-only role used by the API: SELECT on reporting only.
API_READER_USER=api_reader
API_READER_PASSWORD=change_me_api
# Host port for the API container (http://127.0.0.1:8000/docs).
API_PORT=8000

# Test database: same layers, separate roles that cannot connect to the real warehouse.
TEST_POSTGRES_DB=warehouse_test
TEST_PIPELINE_USER=test_pipeline
TEST_PIPELINE_PASSWORD=change_me_test_pipeline
TEST_API_READER_USER=test_api_reader
TEST_API_READER_PASSWORD=change_me_test_api

# Dagster's own run/schedule/event storage: a separate database, not the warehouse.
# Its role cannot connect to the warehouse, and the warehouse roles cannot connect to it.
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=change_me_dagster
# Host port for the Dagster UI (http://127.0.0.1:3030). 3000 is often taken by web dev servers.
DAGSTER_PORT=3030
